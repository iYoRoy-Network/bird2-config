{% if bird.log_syslog_all | default(false) %}
log syslog all;

{% endif %}
# community vocabulary (see group_vars/all/communities.yml)
{% for _name, _value in bgp_community.items() %}
define COMM_{{ _name }} = {{ _value }};
{% endfor %}
{% if dn42 is defined and dn42.enabled | default(false) %}
define GEO_COMM_AS = {{ dn42_global.geo_comm_as }};
{% endif %}
{% for _name, _code in geo_region.items() %}
define GEO_REGION_{{ _name }} = {{ _code }};
{% endfor %}
{% for _name, _code in geo_country.items() %}
define GEO_COUNTRY_{{ _name }} = {{ _code }};
{% endfor %}
{% set pop_geo = node.geo %}
define POP_REGION = {{ pop_geo.region | geo_define(geo_region, 'region') }};
define POP_COUNTRY = {{ pop_geo.country | geo_define(geo_country, 'country') }};
{% if intra is not defined %}{% set intra = {} %}{% endif %}
define INTRA_CONFEDERATION_START = {{ intra_global.confederation_start }};
define INTRA_CONFEDERATION_END   = {{ intra_global.confederation_end }};

protocol device {
    scan time {{ bird.device_scan_time | default(10) }};
}

{% set domain_config = {'iana': iana | default({}), 'dn42': dn42 | default({}), 'intra': intra | default({})} %}
{% set domain_files = bird_domain_files | default(domain_config | bird_modules) %}

{% set _iana_has_peers = (iana.peers | default([]) | length) > 0 %}
{% set _iana_has_downstreams = (iana.downstreams | default([]) | length) > 0 %}
{% set _iana_irr_queries = iana | irr_queries %}

{# ── Render includes ── #}
{% set root_includes = ['filter.conf'] %}
{% if domain_files.iana | length > 0 and _iana_irr_queries %}
{% set root_includes = root_includes + ['iana_downstream_whitelist.conf'] %}
{% endif %}
{% set root_includes = root_includes + (bird.extra_root_includes | default([])) %}
{% for include in root_includes | unique %}
include "{{ include }}";
{% endfor %}

{% for domain, files in domain_files.items() %}
{% for include in files %}
include "{{ domain }}/{{ include }}";
{% endfor %}
{% endfor %}

include "kernel.conf";
