function dn42_ebgp_add_community(){
    bgp_large_community.add((DN42_OWNAS,COMM_FN_IDENTIFY,COMM_ORIGIN_PEER));
    bgp_large_community.add((DN42_OWNAS,COMM_FN_IDENTIFY,COMM_ORIGIN_UPSTREAM));
}

function dn42_ebgp_check_community(){
    if !(bgp_large_community ~ [(DN42_OWNAS,COMM_FN_IDENTIFY,*)]) then return false;
    if bgp_community ~ [(65535,65281)] then reject;
    if bgp_community ~ [(65535,65282)] then reject;

    return true;
}

function dn42_ebgp_export_v4(int peer_as) -> bool {
    if !(is_valid_dn42_network() && source ~ [RTS_STATIC, RTS_BGP]) then return false;
    if roa_check(dn42_roa_flap_v4, net, bgp_path.last) = ROA_INVALID then return false;
    if !dn42_ebgp_check_community() then return false;
    if is_self_dn42_net() then {
        bgp_community.add((GEO_COMM_AS, DN42_REGION));
        bgp_community.add((GEO_COMM_AS, DN42_COUNTRY));
    }
    if !dn42_apply_export(peer_as) then return false;
    remove_confederation_as();
    remove_private_community();
    return true;
}

function dn42_ebgp_export_v6(int peer_as) -> bool {
    if !(is_valid_dn42_network_v6() && source ~ [RTS_STATIC, RTS_BGP]) then return false;
    if roa_check(dn42_roa_flap_v6, net, bgp_path.last) = ROA_INVALID then return false;
    if !dn42_ebgp_check_community() then return false;
    if is_self_dn42_net_v6() then {
        bgp_community.add((GEO_COMM_AS, DN42_REGION));
        bgp_community.add((GEO_COMM_AS, DN42_COUNTRY));
    }
    if !dn42_apply_export(peer_as) then return false;
    remove_confederation_as();
    remove_private_community();
    return true;
}

{% for af in ['v4', 'v6'] %}
function dn42_ebgp_import_{{ af }}(int peer_region; int peer_country) {
    if {{ 'is_valid_dn42_network() && !is_self_dn42_net()' if af == 'v4' else 'is_valid_dn42_network_v6() && !is_self_dn42_net_v6()' }} then {
        if roa_check({{ 'dn42_roa' if af == 'v4' else 'dn42_roa_v6' }}, net, bgp_path.last) != ROA_VALID then {
            print "[dn42] ROA check failed for ", net, " ASN ", bgp_path.last;
            reject;
        }
        bgp_local_pref = dn42_ebgp_calculate_priority();
        remove_confederation_as();
        remove_identity_community();
        dn42_ebgp_add_community();
        dn42_add_geo(peer_region, peer_country);
        accept;
    }
    reject;
}
{% endfor %}

{% if dn42.router_id is defined %}
{% set dn42_router_id = dn42.router_id %}
{% elif dn42.own_ip is defined %}
{% set dn42_router_id = dn42.own_ip %}
{% else %}
{% set dn42_router_id = intra.loopback_v4 | default(derived_intra_loopback_v4) %}
{% endif %}
template bgp dnpeers {
    router id {{ dn42_router_id }};
    local as DN42_OWNAS;
    path metric 1;

    ipv4 {
        table master4;
        import filter {
            dn42_ebgp_import_v4(POP_REGION, POP_COUNTRY);
        };

        export filter {
            if !dn42_ebgp_export_v4(0) then reject;
            accept;
        };
    };

    ipv6 {
        table master6;
        import filter {
            dn42_ebgp_import_v6(POP_REGION, POP_COUNTRY);
        };
        export filter {
            if !dn42_ebgp_export_v6(0) then reject;
            accept;
        };
    };
}


include "peers/*";

