{% set _flap_server_v6 = hostvars['hkg01-hk'].node | intra_loopback_v6(intra_global) %}
protocol bgp dn42_flapalerted {
    router id {{ derived_intra_loopback_v4 }};
    local {{ derived_intra_loopback_v6 }} as DN42_OWNAS;
    neighbor {{ _flap_server_v6 }} as DN42_OWNAS port {{ dn42.flapalerted.neighbor.port }};

    ipv4 {
        table master4;
        add paths on;
        export where bgp_large_community ~ [(DN42_OWNAS,COMM_FN_IDENTIFY,*)];
        import none;
        extended next hop on;
    };

    ipv6 {
        table master6;
        add paths on;
        export where bgp_large_community ~ [(DN42_OWNAS,COMM_FN_IDENTIFY,*)];
        import none;
    };
}

roa4 table dn42_roa_flap_v4;
roa6 table dn42_roa_flap_v6;

protocol rpki dn42_rpki_flapalerted {
    roa4 { table dn42_roa_flap_v4; };
    roa6 { table dn42_roa_flap_v6; };
    remote {{ _flap_server_v6 }} port {{ dn42.flapalerted.rpki_remote.port }};
    max version 1;
    retry keep 10;
};
