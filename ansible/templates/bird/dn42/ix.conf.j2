function dn42_ix_add_community(){
    bgp_large_community.add((DN42_OWNAS,COMM_FN_IDENTIFY,COMM_ORIGIN_PEER));
}

function dn42_ix_check_community(){
    if !(bgp_large_community ~ [(DN42_OWNAS,COMM_FN_IDENTIFY,*)]) then return false;
    if bgp_community ~ [(65535,65281)] then reject;
    if bgp_community ~ [(65535,65282)] then reject;

    if bgp_large_community ~ [(DN42_OWNAS,COMM_FN_IDENTIFY,COMM_ORIGIN_PEER)] then return false;
    if bgp_large_community ~ [(DN42_OWNAS,COMM_FN_IDENTIFY,COMM_ORIGIN_UPSTREAM)] then return false;

    return true;
}

function dn42_ix_export_v4(int peer_as) -> bool {
    if !(is_valid_dn42_network() && source ~ [RTS_STATIC, RTS_BGP]) then return false;
    if roa_check(dn42_roa_flap_v4, net, bgp_path.last) = ROA_INVALID then return false;
    if !dn42_ix_check_community() then return false;
    if is_self_dn42_net() then {
        bgp_community.add((GEO_COMM_AS, DN42_REGION));
        bgp_community.add((GEO_COMM_AS, DN42_COUNTRY));
    }
    if !dn42_apply_export(peer_as) then return false;
    remove_confederation_as();
    remove_private_community();
    return true;
}

function dn42_ix_export_v6(int peer_as) -> bool {
    if !(is_valid_dn42_network_v6() && source ~ [RTS_STATIC, RTS_BGP]) then return false;
    if roa_check(dn42_roa_flap_v6, net, bgp_path.last) = ROA_INVALID then return false;
    if !dn42_ix_check_community() then return false;
    if is_self_dn42_net_v6() then {
        bgp_community.add((GEO_COMM_AS, DN42_REGION));
        bgp_community.add((GEO_COMM_AS, DN42_COUNTRY));
    }
    if !dn42_apply_export(peer_as) then return false;
    remove_confederation_as();
    remove_private_community();
    return true;
}

template bgp dn42_ixpeers {
    router id {{ derived_intra_loopback_v4 }};
    local as DN42_OWNAS;
    path metric 1;

    ipv4 {
        table master4;
        import filter {
            if is_valid_dn42_network() && !is_self_dn42_net() then {
                bgp_local_pref = dn42_ebgp_calculate_priority(); 
                remove_confederation_as();
                remove_identity_community();
                dn42_ix_add_community();
                accept;
            }
            reject;
        };

        export filter {
            if !dn42_ix_export_v4(0) then reject;
            accept;
        };
    };

    ipv6 {
        table master6;
        import filter {
            if is_valid_dn42_network_v6() && !is_self_dn42_net_v6() then {
                bgp_local_pref = dn42_ebgp_calculate_priority(); 
                remove_confederation_as();
                remove_identity_community();
                dn42_ix_add_community();
                accept;
            }
            reject;
        };
        export filter {
            if !dn42_ix_export_v6(0) then reject;
            accept;
        };
    };
}
{% for session in dn42.ix.sessions | default([]) %}
protocol bgp '{{ session.protocol }}' from dn42_ixpeers {
{% if session.description is defined and session.description is not none %}    description "{{ session.description | replace('\\', '\\\\') | replace('\"', '\\"') }}";
{% endif %}    neighbor {{ session.neighbor.address }}{% if session.neighbor.interface is defined and session.neighbor.interface %} % '{{ session.neighbor.interface }}'{% endif %} as {{ session.neighbor.asn }};
{% if session.ipv4.extended_next_hop | default(false) %}    ipv4{
        extended next hop;
        export filter { if !dn42_ix_export_v4({{ session.neighbor.asn }}) then reject; accept; };
    };
{% else %}    ipv4{
        export filter { if !dn42_ix_export_v4({{ session.neighbor.asn }}) then reject; accept; };
    };
{% endif %}    ipv6{
        export filter { if !dn42_ix_export_v6({{ session.neighbor.asn }}) then reject; accept; };
    };
};
{% endfor %}
