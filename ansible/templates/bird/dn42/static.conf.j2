{% if dn42.own_ip is defined %}
protocol static dn42_static_v4{
    route {{ dn42_global.own_net }} reject;

    ipv4 {
        import filter{
            bgp_large_community.add((DN42_OWNAS,COMM_FN_IDENTIFY,COMM_ORIGIN_CUSTOMER));
            accept;
        };
        export none;
    };
}
{% endif %}

{% if dn42.own_ipv6 is defined %}
protocol static dn42_static_v6{
    route {{ dn42_global.own_net_v6 }} reject;

    ipv6 {
        import filter{
            bgp_large_community.add((DN42_OWNAS,COMM_FN_IDENTIFY,COMM_ORIGIN_CUSTOMER));
            accept;
        };
        export none;
    };
}
{% endif %}
