function remove_confederation_as() {
    bgp_path.delete([INTRA_CONFEDERATION_START..INTRA_CONFEDERATION_END]);
    bgp_path.delete([4233770000..4233779999]);
}

# Untrusted external input must not supply our internal identity or geo.
# Do not call this on internal sessions: their ingress markers must survive.
{% set dn42_on = dn42 is defined and dn42.enabled | default(false) %}
{% set iana_on = iana is defined and iana.enabled | default(false) %}
{% set route_origin_asns = [] %}
{% if dn42_on %}{% set route_origin_asns = route_origin_asns + [route_domains.dn42.origin_as] %}{% endif %}
{% if iana_on %}{% set route_origin_asns = route_origin_asns + [route_domains.iana.origin_as] %}{% endif %}
{% if bird_route_origin_asns is defined %}{% set route_origin_asns = bird_route_origin_asns %}{% endif %}
function remove_intra_communities(){
    bgp_large_community.delete([({{ route_domains.intra.origin_as }}, COMM_FN_IDENTIFY, *), ({{ route_domains.intra.origin_as }}, COMM_FN_GEO_SRC, *), ({{ route_domains.intra.origin_as }}, COMM_FN_GEO_DST, *)]);
}

function remove_internal_communities(){
    remove_intra_communities();
{% for own_as in [route_domains.dn42.origin_as, route_domains.iana.origin_as] %}    bgp_large_community.delete([({{ own_as }}, COMM_FN_IDENTIFY, *), ({{ own_as }}, COMM_FN_GEO_SRC, *), ({{ own_as }}, COMM_FN_GEO_DST, *)]);
{% endfor %}}

# Strip only the controls implemented here, after the export actions run.
# Foreign communities and unrecognized own-AS function codes pass through.
function remove_export_control_communities(){
{% for own_as in route_origin_asns %}
{% for name in bgp_community if name.startswith(('FN_ATTACH_', 'FN_DENY_', 'FN_ONLY_', 'FN_PREPEND_')) %}
    bgp_large_community.delete([({{ own_as }}, COMM_{{ name }}, *)]);
{% endfor %}
{% endfor %}}

{% if dn42_on %}function dn42_add_geo(int peer_region; int peer_country) {
    bgp_large_community.delete([({{ route_domains.dn42.origin_as }}, COMM_FN_GEO_SRC, *), ({{ route_domains.dn42.origin_as }}, COMM_FN_GEO_DST, *)]);
    bgp_large_community.add(({{ route_domains.dn42.origin_as }}, COMM_FN_GEO_SRC, peer_region));
    bgp_large_community.add(({{ route_domains.dn42.origin_as }}, COMM_FN_GEO_SRC, peer_country));
    bgp_large_community.add(({{ route_domains.dn42.origin_as }}, COMM_FN_GEO_DST, POP_REGION));
    bgp_large_community.add(({{ route_domains.dn42.origin_as }}, COMM_FN_GEO_DST, POP_COUNTRY));
}
{% endif %}

{% if iana_on %}function iana_add_geo(int peer_region; int peer_country) {
    bgp_large_community.delete([({{ route_domains.iana.origin_as }}, COMM_FN_GEO_SRC, *), ({{ route_domains.iana.origin_as }}, COMM_FN_GEO_DST, *)]);
    bgp_large_community.add(({{ route_domains.iana.origin_as }}, COMM_FN_GEO_SRC, peer_region));
    bgp_large_community.add(({{ route_domains.iana.origin_as }}, COMM_FN_GEO_SRC, peer_country));
    bgp_large_community.add(({{ route_domains.iana.origin_as }}, COMM_FN_GEO_DST, POP_REGION));
    bgp_large_community.add(({{ route_domains.iana.origin_as }}, COMM_FN_GEO_DST, POP_COUNTRY));
}
{% endif %}

{% macro export_controls(fn_name, own_as) -%}
# Apply export controls using the target peer's ASN and endpoint geography.
# Match runtime arguments as single tuples; keep sets for constant wildcards.
#   D  650/651:<region>, 660/661:<country>, 670/671:<ASN>  deny / only
#   E  691-696:<ASN>  prepend 1/2/3x to specified / non-specified ASes
#      697-702:<region>, 703-708:<country>  same for endpoint geography
#   A  1xxxxx/2xxxxx  attach well-known community to specified/all / others
function {{ fn_name }}(int peer_as; int peer_region; int peer_country) -> bool {
{% for kind in ['REGION', 'COUNTRY'] %}
    if ({{ own_as }}, COMM_FN_DENY_{{ kind }}, peer_{{ kind | lower }}) ~ bgp_large_community then return false;
    if bgp_large_community ~ [({{ own_as }}, COMM_FN_ONLY_{{ kind }}, *)] &&
       !(({{ own_as }}, COMM_FN_ONLY_{{ kind }}, peer_{{ kind | lower }}) ~ bgp_large_community) then return false;
{% endfor %}
    if ({{ own_as }}, COMM_FN_DENY_AS, peer_as) ~ bgp_large_community then return false;
    if bgp_large_community ~ [({{ own_as }}, COMM_FN_ONLY_AS, *)] &&
       !(({{ own_as }}, COMM_FN_ONLY_AS, peer_as) ~ bgp_large_community) then return false;

    if ({{ own_as }}, COMM_FN_PREPEND_AS_1, peer_as) ~ bgp_large_community then bgp_path.prepend({{ own_as }});
    if ({{ own_as }}, COMM_FN_PREPEND_AS_2, peer_as) ~ bgp_large_community then { bgp_path.prepend({{ own_as }}); bgp_path.prepend({{ own_as }}); }
    if ({{ own_as }}, COMM_FN_PREPEND_AS_3, peer_as) ~ bgp_large_community then { bgp_path.prepend({{ own_as }}); bgp_path.prepend({{ own_as }}); bgp_path.prepend({{ own_as }}); }
    if bgp_large_community ~ [({{ own_as }}, COMM_FN_PREPEND_AS_OTHERS_1, *)] &&
       !(({{ own_as }}, COMM_FN_PREPEND_AS_OTHERS_1, peer_as) ~ bgp_large_community) then bgp_path.prepend({{ own_as }});
    if bgp_large_community ~ [({{ own_as }}, COMM_FN_PREPEND_AS_OTHERS_2, *)] &&
       !(({{ own_as }}, COMM_FN_PREPEND_AS_OTHERS_2, peer_as) ~ bgp_large_community) then { bgp_path.prepend({{ own_as }}); bgp_path.prepend({{ own_as }}); }
    if bgp_large_community ~ [({{ own_as }}, COMM_FN_PREPEND_AS_OTHERS_3, *)] &&
       !(({{ own_as }}, COMM_FN_PREPEND_AS_OTHERS_3, peer_as) ~ bgp_large_community) then { bgp_path.prepend({{ own_as }}); bgp_path.prepend({{ own_as }}); bgp_path.prepend({{ own_as }}); }

{% for kind in ['REGION', 'COUNTRY'] %}
{% for count in [1, 2, 3] %}
    if ({{ own_as }}, COMM_FN_PREPEND_{{ kind }}_{{ count }}, peer_{{ kind | lower }}) ~ bgp_large_community then {
{% for _ in range(count) %}
        bgp_path.prepend({{ own_as }});
{% endfor %}
    }
    if bgp_large_community ~ [({{ own_as }}, COMM_FN_PREPEND_{{ kind }}_OTHERS_{{ count }}, *)] &&
       !(({{ own_as }}, COMM_FN_PREPEND_{{ kind }}_OTHERS_{{ count }}, peer_{{ kind | lower }}) ~ bgp_large_community) then {
{% for _ in range(count) %}
        bgp_path.prepend({{ own_as }});
{% endfor %}
    }
{% endfor %}
{% endfor %}

    if bgp_large_community ~ [({{ own_as }}, COMM_FN_ATTACH_BLACKHOLE, 0)] ||
       ({{ own_as }}, COMM_FN_ATTACH_BLACKHOLE, peer_as) ~ bgp_large_community then
        bgp_community.add((COMM_FN_WELLKNOWN, COMM_WK_BLACKHOLE));
    if bgp_large_community ~ [({{ own_as }}, COMM_FN_ATTACH_NO_EXPORT, 0)] ||
       ({{ own_as }}, COMM_FN_ATTACH_NO_EXPORT, peer_as) ~ bgp_large_community then
        bgp_community.add((COMM_FN_WELLKNOWN, COMM_WK_NO_EXPORT));
    if bgp_large_community ~ [({{ own_as }}, COMM_FN_ATTACH_NO_ADVERTISE, 0)] ||
       ({{ own_as }}, COMM_FN_ATTACH_NO_ADVERTISE, peer_as) ~ bgp_large_community then
        bgp_community.add((COMM_FN_WELLKNOWN, COMM_WK_NO_ADVERTISE));
    if bgp_large_community ~ [({{ own_as }}, COMM_FN_ATTACH_BLACKHOLE_OTHERS, *)] &&
       !(({{ own_as }}, COMM_FN_ATTACH_BLACKHOLE_OTHERS, peer_as) ~ bgp_large_community) then
        bgp_community.add((COMM_FN_WELLKNOWN, COMM_WK_BLACKHOLE));
    if bgp_large_community ~ [({{ own_as }}, COMM_FN_ATTACH_NO_EXPORT_OTHERS, *)] &&
       !(({{ own_as }}, COMM_FN_ATTACH_NO_EXPORT_OTHERS, peer_as) ~ bgp_large_community) then
        bgp_community.add((COMM_FN_WELLKNOWN, COMM_WK_NO_EXPORT));
    if bgp_large_community ~ [({{ own_as }}, COMM_FN_ATTACH_NO_ADVERTISE_OTHERS, *)] &&
       !(({{ own_as }}, COMM_FN_ATTACH_NO_ADVERTISE_OTHERS, peer_as) ~ bgp_large_community) then
        bgp_community.add((COMM_FN_WELLKNOWN, COMM_WK_NO_ADVERTISE));

    return true;
}
{%- endmacro %}
