function remove_confederation_as() {
    bgp_path.delete([INTRA_CONFEDERATION_START..INTRA_CONFEDERATION_END]);
    bgp_path.delete([4233770000..4233779999]);
}

function remove_private_community(){
{% for own_as in bird_own_as_defines %}    bgp_large_community.delete([({{ own_as }}, *, *)]);
{% endfor %}}

# Strip only the internal identity marker (ASN, FN_IDENTIFY, *) so that
# control communities injected by peers/customers survive for our own
# export logic to act on.
function remove_identity_community(){
{% for own_as in bird_own_as_defines %}    bgp_large_community.delete([({{ own_as }}, COMM_FN_IDENTIFY, *)]);
{% endfor %}}

function get_unique_as_path_len() -> int
int last;
int cnt;
{
    cnt = 0;
    last = 0;

    for int asn in bgp_path do {
        if asn != last then {
            cnt = cnt + 1;
            last = asn;
        }
    }

    return cnt;
}