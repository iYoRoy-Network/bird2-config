function get_unique_as_path_len() -> int
int last;
int cnt;
{
    cnt = 0;
    last = 0;

    for int asn in bgp_path do {
        if asn != last then {
            cnt = cnt + 1;
            last = asn;
        }
    }

    return cnt;
}
