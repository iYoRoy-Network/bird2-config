{% set ns = namespace(import_policies=[], export_policies=[]) %}
{% for downstream in iana.downstreams | default([]) %}
{% set import_policy = downstream.import_policy | default('default') %}
{% set export_policy = downstream.export_policy | default('default') %}
{% if import_policy not in ns.import_policies %}{% set ns.import_policies = ns.import_policies + [import_policy] %}{% endif %}
{% if export_policy not in ns.export_policies %}{% set ns.export_policies = ns.export_policies + [export_policy] %}{% endif %}
{% endfor %}
function iana_downstream_add_community(){
    bgp_large_community.add(({{ route_domains.iana.origin_as }},COMM_FN_IDENTIFY,COMM_ORIGIN_CUSTOMER));
}

function iana_downstream_check_community(){
    if !(bgp_large_community ~ [({{ route_domains.iana.origin_as }},COMM_FN_IDENTIFY,*)]) then return false;
    if bgp_community ~ [(65535,65281)] then reject;
    if bgp_community ~ [(65535,65282)] then reject;
    return true;
}
{% if 'default' in ns.import_policies %}
function iana_downstream_import_default(int peer_region; int peer_country) {
    if !iana_filter_default_check() then reject;
    if is_self_iana_v6() then reject;
    remove_confederation_as();
    remove_internal_communities();
    iana_downstream_add_community();
    iana_add_geo(peer_region, peer_country);
    accept;
}
{% endif %}
{% if 'reject' in ns.import_policies %}
function iana_downstream_import_reject(int peer_region; int peer_country) {
    reject;
}
{% endif %}
{% if 'default' in ns.export_policies %}
function iana_downstream_export_default(int peer_as; int peer_region; int peer_country) -> bool {
    if !iana_filter_default_check() then return false;
    if !iana_downstream_check_community() then return false;
    if !iana_apply_export(peer_as, peer_region, peer_country) then return false;
    remove_confederation_as();
    remove_internal_communities();
    remove_export_control_communities();
    return true;
}
{% endif %}
{% if 'own_only' in ns.export_policies %}
function iana_downstream_export_own_only(int peer_as; int peer_region; int peer_country) -> bool {
    if !iana_filter_default_check() then return false;
    if !iana_downstream_check_community() then return false;
    if !is_self_iana_v6() then return false;
    if !iana_apply_export(peer_as, peer_region, peer_country) then return false;
    remove_confederation_as();
    remove_internal_communities();
    remove_export_control_communities();
    return true;
}
{% endif %}
{% if 'reject' in ns.export_policies %}
function iana_downstream_export_reject(int peer_as; int peer_region; int peer_country) -> bool {
    return false;
}
{% endif %}
template bgp iana_downstream {
    router id {{ iana.router_id }};
    local as {{ route_domains.iana.origin_as }};
    path metric 1;
    graceful restart;

    ipv4 {
        next hop self;
        import none;
        export none;
    };
    ipv6 {
        next hop self;
        import none;
        export none;
    };
}
{% for downstream in iana.downstreams | default([]) %}
{% set import_policy = downstream.import_policy | default('default') %}
{% set export_policy = downstream.export_policy | default('default') %}
protocol bgp '{{ downstream.protocol }}' from iana_downstream{
{% if downstream.description is defined and downstream.description is not none %}    description "{{ downstream.description | replace('\\', '\\\\') | replace('\"', '\\"') }}";
{% endif %}{% if downstream.local is defined %}    local {{ downstream.local }};
{% endif %}    neighbor {{ downstream.neighbor.address }}{% if downstream.neighbor.interface is defined and downstream.neighbor.interface %} % '{{ downstream.neighbor.interface }}'{% endif %} as {{ downstream.neighbor.asn }};
{% if downstream.multihop is defined %}    multihop {{ downstream.multihop }};
{% endif %}{% if downstream.direct | default(false) %}    direct;
{% endif %}{% if downstream.password_ref is defined %}    password "{{ bird_secrets.bgp_passwords[downstream.password_ref] | replace('\\', '\\\\') | replace('\"', '\\"') }}";
{% endif %}    ipv6 {
        import filter
        {
{% if (downstream.as_set | default('none') | lower) != 'none' %}
            if (bgp_path.last !~ downstream_{{ downstream.neighbor.asn }}_as_set) then 
            {
                reject;
            }
{% else %}
            if (get_unique_as_path_len() > 1) then
            {
                reject;
            }
{% endif %}
            iana_downstream_import_{{ import_policy }}({{ downstream.geo | default({}) | geo_args(geo_region, geo_country) }});
        };
        export filter {
            if !iana_downstream_export_{{ export_policy }}({{ downstream.neighbor.asn }}, {{ downstream.geo | default({}) | geo_args(geo_region, geo_country) }}) then reject;
            accept;
        };
    };
}
{% endfor %}
