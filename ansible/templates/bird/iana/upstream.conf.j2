{% for upstream in iana.upstreams4 | default([]) %}
protocol bgp '{{ upstream.protocol }}' from iana_upstream_v4{
{% if upstream.description is defined and upstream.description is not none %}    description "{{ upstream.description | replace('\\', '\\\\') | replace('\"', '\\"') }}";
{% endif %}    neighbor {{ upstream.neighbor.address }} as {{ upstream.neighbor.asn }};
{% if upstream.multihop is defined %}    multihop {{ upstream.multihop }};
{% endif %}{% if upstream.password_ref is defined %}    password "{{ bird_secrets.bgp_passwords[upstream.password_ref] | replace('\\', '\\\\') | replace('\"', '\\"') }}";
{% endif %}
    ipv4 {
        next hop self;
        import filter {
            if !iana_filter_default_check() then reject;
            remove_confederation_as();
            remove_identity_community();
            iana_upstream_add_community();
            iana_add_geo({{ upstream.geo | default({}) | geo_args(geo_region, geo_country) }});
{% for rewrite in upstream.next_hop_rewrites | default([]) %}            if bgp_next_hop = {{ rewrite.from }} then {
                bgp_next_hop = {{ rewrite.to }};
            }
{% endfor %}            accept;
        };
        export filter {
            if !iana_upstream_export_default() then reject;
            if !iana_apply_export({{ upstream.neighbor.asn }}) then reject;
            accept;
        };
        export limit 50;
    };
}
{% endfor %}

