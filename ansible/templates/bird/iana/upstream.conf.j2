function iana_upstream_add_community(){
    bgp_large_community.add((IANA_OWNAS,COMM_FN_IDENTIFY,COMM_ORIGIN_UPSTREAM));
}

function iana_upstream_check_community(){
    if !(bgp_large_community ~ [(IANA_OWNAS,COMM_FN_IDENTIFY,*)]) then return false;
    if bgp_community ~ [(65535,65281)] then reject;
    if bgp_community ~ [(65535,65282)] then reject;

    if bgp_large_community ~ [(IANA_OWNAS,COMM_FN_IDENTIFY,COMM_ORIGIN_PEER)] then return false;
    if bgp_large_community ~ [(IANA_OWNAS,COMM_FN_IDENTIFY,COMM_ORIGIN_UPSTREAM)] then return false;

    return true;
}

function iana_upstream_export_default() -> bool {
    if !iana_filter_default_check() then return false;
    if !iana_upstream_check_community() then return false;
    remove_confederation_as();
    remove_private_community();
    return true;
}

template bgp iana_upstream_v4 {
    local as IANA_OWNAS;
    path metric 1;
    router id IANA_ROUTER_ID;

    ipv4 {
        next hop self;
        import filter {
            if !iana_filter_default_check() then reject;
            remove_confederation_as();
            remove_identity_community();
            iana_upstream_add_community();
            iana_add_geo(POP_REGION, POP_COUNTRY);
            accept;
        };
        export filter {
            if !iana_filter_default_check() then reject;
            if !iana_upstream_check_community() then reject;
            remove_confederation_as();
            remove_private_community();
            accept;
        };
        export limit 50;
    };

    graceful restart; 
}

