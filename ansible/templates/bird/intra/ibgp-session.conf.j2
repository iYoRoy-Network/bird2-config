{% if session.neighbor.node is defined %}
{% set neighbor_node = hostvars[session.neighbor.node].node %}
{% set neighbor_address = neighbor_node | intra_lla(intra_global) %}
{% else %}
{% set neighbor_address = session.neighbor.address %}
{% endif %}
protocol bgp '{{ session.protocol }}' from intra_ibgpeers{
{% if session.local_as is defined %}    local as {{ session.local_as }};
{% endif %}    neighbor {{ neighbor_address }} % '{{ session.neighbor.interface }}';
    ipv4{
        table master4;
        import filter intra_ibgp_import_{{ session.ipv4.import_policy }};
        export filter intra_ibgp_export_{{ session.ipv4.export_policy }};
        extended next hop;
    };
    ipv6{
        table master6;
        import filter intra_ibgp_import_{{ session.ipv6.import_policy }};
        export filter intra_ibgp_export_{{ session.ipv6.export_policy }};
    };
};
