{% set all_sessions = effective_intra_ibgp_sessions | default(intra.explicit_confed_peers | default([])) %}
{% set ns = namespace(import_policies=[], export_policies=[]) %}
{% for session in all_sessions %}
{% set ipv4 = session.ipv4 | default({}) %}
{% set ipv6 = session.ipv6 | default({}) %}
{% set ipv4_import_policy = ipv4.import_policy | default(session.import_policy | default('default')) %}
{% set ipv4_export_policy = ipv4.export_policy | default(session.export_policy | default('default')) %}
{% set ipv6_import_policy = ipv6.import_policy | default(session.import_policy | default('default')) %}
{% set ipv6_export_policy = ipv6.export_policy | default(session.export_policy | default('default')) %}
{% if ipv4_import_policy not in ns.import_policies %}{% set ns.import_policies = ns.import_policies + [ipv4_import_policy] %}{% endif %}
{% if ipv6_import_policy not in ns.import_policies %}{% set ns.import_policies = ns.import_policies + [ipv6_import_policy] %}{% endif %}
{% if ipv4_export_policy not in ns.export_policies %}{% set ns.export_policies = ns.export_policies + [ipv4_export_policy] %}{% endif %}
{% if ipv6_export_policy not in ns.export_policies %}{% set ns.export_policies = ns.export_policies + [ipv6_export_policy] %}{% endif %}
{% endfor %}
{% set dn42_on = dn42 is defined and dn42.enabled | default(false) %}
{% set iana_on = iana is defined and iana.enabled | default(false) %}
function intra_is_underlay_route() -> bool {
    if net ~ {{ intra_global.prefix_v4 }} && bgp_large_community ~ [({{ route_domains.intra.origin_as }},COMM_FN_IDENTIFY,COMM_ORIGIN_CUSTOMER)] then return true;
    if net ~ {{ intra_global.prefix_v6 }} && bgp_large_community ~ [({{ route_domains.intra.origin_as }},COMM_FN_IDENTIFY,COMM_ORIGIN_CUSTOMER)] then return true;
    if net ~ {{ intra_global.prefix_v4 }} && bgp_large_community ~ [({{ route_domains.dn42.origin_as }},COMM_FN_IDENTIFY,COMM_ORIGIN_CUSTOMER),({{ route_domains.iana.origin_as }},COMM_FN_IDENTIFY,COMM_ORIGIN_CUSTOMER)] then return true;
    if net ~ {{ intra_global.prefix_v6 }} && bgp_large_community ~ [({{ route_domains.dn42.origin_as }},COMM_FN_IDENTIFY,COMM_ORIGIN_CUSTOMER),({{ route_domains.iana.origin_as }},COMM_FN_IDENTIFY,COMM_ORIGIN_CUSTOMER)] then return true;
    return false;
}
{% set route_origin_asns = [] %}
{% if dn42_on %}{% set route_origin_asns = route_origin_asns + [route_domains.dn42.origin_as] %}{% endif %}
{% if iana_on %}{% set route_origin_asns = route_origin_asns + [route_domains.iana.origin_as] %}{% endif %}
{% if bird_route_origin_asns is defined %}{% set route_origin_asns = bird_route_origin_asns %}{% endif %}
{% if 'default' in ns.import_policies %}
filter intra_ibgp_import_default {
    # no-advertise
    if bgp_community ~ [(65535,65282)] then reject;

    if intra_is_underlay_route() then accept;

    # require a known origin in an enabled domain
{% for own_as in route_origin_asns %}    if bgp_large_community ~ [({{ own_as }},COMM_FN_IDENTIFY,*)] then accept;
{% endfor %}
    # default: reject
    reject;
}
{% endif %}
{% if 'default' in ns.export_policies %}
filter intra_ibgp_export_default {
    # no-advertise
    if bgp_community ~ [(65535,65282)] then reject;

    if intra_is_underlay_route() then accept;

    # require a known origin in an enabled domain
{% for own_as in route_origin_asns %}    if bgp_large_community ~ [({{ own_as }},COMM_FN_IDENTIFY,*)] then accept;
{% endfor %}
    # default: reject
    reject;
}
{% endif %}

{% if iana_on and 'iana_full' in ns.import_policies %}
filter intra_ibgp_import_iana_full {
    # no-advertise
    if bgp_community ~ [(65535,65282)] then reject;

    if intra_is_underlay_route() then accept;

    # iana origin only
    if bgp_large_community ~ [({{ route_domains.iana.origin_as }},COMM_FN_IDENTIFY,*)] then accept;

    # default: reject
    reject;
}
{% endif %}
{% if iana_on and 'iana_full' in ns.export_policies %}
filter intra_ibgp_export_iana_full {
    # no-advertise
    if bgp_community ~ [(65535,65282)] then reject;

    if intra_is_underlay_route() then accept;

    # iana origin only
    if bgp_large_community ~ [({{ route_domains.iana.origin_as }},COMM_FN_IDENTIFY,*)] then accept;

    # default: reject
    reject;
}
{% endif %}

{% if dn42_on and 'dn42_full' in ns.import_policies %}
filter intra_ibgp_import_dn42_full {
    # no-advertise
    if bgp_community ~ [(65535,65282)] then reject;

    if intra_is_underlay_route() then accept;

    # dn42 origin only
    if bgp_large_community ~ [({{ route_domains.dn42.origin_as }},COMM_FN_IDENTIFY,*)] then accept;

    # default: reject
    reject;
}
{% endif %}
{% if dn42_on and 'dn42_full' in ns.export_policies %}
filter intra_ibgp_export_dn42_full {
    # no-advertise
    if bgp_community ~ [(65535,65282)] then reject;

    if intra_is_underlay_route() then accept;

    # dn42 origin only
    if bgp_large_community ~ [({{ route_domains.dn42.origin_as }},COMM_FN_IDENTIFY,*)] then accept;

    # default: reject
    reject;
}
{% endif %}

{% if 'full' in ns.import_policies %}
filter intra_ibgp_import_full {
    # no-advertise
    if bgp_community ~ [(65535,65282)] then reject;

    if intra_is_underlay_route() then accept;

    # require a known origin in an enabled domain
{% for own_as in route_origin_asns %}    if bgp_large_community ~ [({{ own_as }},COMM_FN_IDENTIFY,*)] then accept;
{% endfor %}
    # default: reject
    reject;
}
{% endif %}
{% if 'full' in ns.export_policies %}
filter intra_ibgp_export_full {
    # no-advertise
    if bgp_community ~ [(65535,65282)] then reject;

    if intra_is_underlay_route() then accept;

    # require a known origin in an enabled domain
{% for own_as in route_origin_asns %}    if bgp_large_community ~ [({{ own_as }},COMM_FN_IDENTIFY,*)] then accept;
{% endfor %}
    # default: reject
    reject;
}
{% endif %}

{% if iana_on and '3377confed_iana' in ns.import_policies %}
filter intra_ibgp_import_3377confed_iana {
    # no-advertise
    if bgp_community ~ [(65535,65282)] then reject;

    if intra_is_underlay_route() then reject;

{% if iana_on %}    # control: allow from iana
    if bgp_large_community ~ [({{ route_domains.iana.origin_as }},COMM_FN_IDENTIFY,*)] then {
        remove_intra_communities();
        accept;
    }

{% endif %}    # allow from 3377 igp
    if bgp_large_community ~ [(4242423377, 0, 36)] then {
{% if iana_on %}        bgp_large_community.add(({{ route_domains.iana.origin_as }},COMM_FN_IDENTIFY,COMM_ORIGIN_CUSTOMER));
{% endif %}        remove_intra_communities();
        accept;
    }

    # default: reject
    reject;
}
{% endif %}
{% if iana_on and '3377confed_iana' in ns.export_policies %}
filter intra_ibgp_export_3377confed_iana {
    # no-advertise
    if bgp_community ~ [(65535,65282)] then reject;

    if intra_is_underlay_route() then reject;

{% if iana_on %}    # control: allow from iana
    if bgp_large_community ~ [({{ route_domains.iana.origin_as }},COMM_FN_IDENTIFY,*)] then {
        remove_intra_communities();
        accept;
    }

{% endif %}    # allow from 3377 igp
    if bgp_large_community ~ [(4242423377, 0, 36)] then {
{% if iana_on %}        bgp_large_community.delete(({{ route_domains.iana.origin_as }},COMM_FN_IDENTIFY,COMM_ORIGIN_CUSTOMER));
{% endif %}        remove_intra_communities();
        accept;
    }

    # default: reject
    reject;
}
{% endif %}

template bgp intra_ibgpeers {
    router   id {{ intra.router_id | default(derived_intra_loopback_v4) }};
    local    as {{ derived_intra_as }};
    neighbor external;
    interpret communities off;
};

include "ibgp/*";
