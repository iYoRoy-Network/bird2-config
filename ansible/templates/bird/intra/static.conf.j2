{% macro render_communities(community_list, indent='        ') -%}
{% for community in community_list | default([]) -%}
{% if community | length == 2 -%}
{{ indent }}bgp_community.add(({{ community | join(',') }}));
{% else -%}
{{ indent }}bgp_large_community.add(({{ community | join(',') }}));
{% endif -%}
{% endfor -%}
{% endmacro %}
{% set intra_static = intra.static | default({}) %}
{% set underlay_loopback = intra_static.underlay_loopback | default({}) %}
{% set underlay_loopback_enabled = underlay_loopback.enabled | default(true) %}
{% set dn42_on = dn42 is defined and dn42.enabled | default(false) %}
{% set iana_on = iana is defined and iana.enabled | default(false) %}
{% set dn42_overlay_communities = intra_global.dn42_overlay_route_communities | default([]) %}
{% set iana_overlay_communities = intra_global.iana_overlay_route_communities | default([]) %}
{% set overlay_default_communities = dn42_overlay_communities if dn42_on else iana_overlay_communities if iana_on else [] %}
{% if underlay_loopback.communities is defined %}
{% set underlay_loopback_communities = underlay_loopback.communities %}
{% elif dn42_on %}
{% set underlay_loopback_communities = intra_global.underlay_loopback_communities | default([]) %}
{% elif iana_on %}
{% set underlay_loopback_communities = iana_overlay_communities %}
{% else %}
{% set underlay_loopback_communities = [] %}
{% endif %}
protocol static intra_static_v4{
{% if underlay_loopback_enabled %}    route {{ derived_intra_loopback_v4 }}/32 reject{
{{ render_communities(underlay_loopback_communities) }}    };
{% endif %}{% if dn42 is defined and dn42.enabled | default(false) and dn42.own_ip is defined %}    route {{ dn42.own_ip }}/32 reject{
{{ render_communities(overlay_default_communities) }}    };
{% endif %}{% for route in intra_static.v4_routes | default([], true) %}    route {{ route.prefix }} reject{
{{ render_communities(route.communities | default(overlay_default_communities)) }}    };
{% endfor %}
    ipv4 {
        import all;
        export none;
    };
}

protocol static intra_static_v6{
{% if underlay_loopback_enabled %}    route {{ derived_intra_loopback_v6 }}/128 reject{
{{ render_communities(underlay_loopback_communities) }}    };
{% endif %}{% if dn42_on and dn42.own_ipv6 is defined %}    route {{ dn42.own_ipv6 }}/128 reject{
{{ render_communities(overlay_default_communities) }}    };
{% endif %}{% if iana_on %}
    route {{ derived_public_ipv6 }}/128 reject{
{{ render_communities(iana_overlay_communities) }}    };
{% endif %}{% for route in intra_static.v6_routes | default([], true) %}    route {{ route.prefix }} reject{
{{ render_communities(route.communities | default(overlay_default_communities)) }}    };
{% endfor %}
    ipv6 {
        import all;
        export none;
    };
}
