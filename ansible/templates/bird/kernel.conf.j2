protocol kernel kernel_v4{
    ipv4 {
        table master4;
        import none;
        export filter {
            if source = RTS_STATIC then {
{% for own_as in bird_own_as_defines %}                if bgp_large_community ~ [({{ own_as }},*,*)] then accept;
{% endfor %}                if bgp_community ~ [(65535,65282)] then accept;
                reject;
            }
            krt_prefsrc = {{ derived_intra_loopback_v4 }};
{% if dn42 is defined and dn42.own_ip is defined %}            if bgp_large_community ~ [(DN42_OWNAS,*,*)] && !(net ~ {{ intra_global.prefix_v4 }}) then krt_prefsrc = {{ dn42.own_ip }};
{% endif %}            accept;
        };
    };
}

protocol kernel kernel_v6 {
    ipv6 {
        table master6;
        import none;
        export filter {
            if source = RTS_STATIC then {
{% for own_as in bird_own_as_defines %}                if bgp_large_community ~ [({{ own_as }},*,*)] then accept;
{% endfor %}                if bgp_community ~ [(65535,65282)] then accept;
                reject;
            }
            krt_prefsrc = {{ derived_intra_loopback_v6 }};
{% if dn42 is defined and dn42.own_ipv6 is defined %}            if bgp_large_community ~ [(DN42_OWNAS,*,*)] && !(net ~ {{ intra_global.prefix_v6 }}) then krt_prefsrc = {{ dn42.own_ipv6 }};
{% endif %}{% if iana is defined and iana.enabled | default(false) %}            if bgp_large_community ~ [(IANA_OWNAS,*,*)] && !(net ~ {{ intra_global.prefix_v6 }}) then krt_prefsrc = {{ iana.own_ipv6 | default(derived_public_ipv6) }};
{% endif %}            accept;
        };
    };
}
